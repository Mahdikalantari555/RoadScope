# Copy to .env before running `docker compose up --build`.
# SQLite is the only supported runtime database; no PostGIS service is required.
# ROADSCOPE_* settings take precedence over equivalent legacy UAI_* names.
ROADSCOPE_API_PORT=8000
ROADSCOPE_WEB_PORT=8080
# Fallback metric CRS only. Each dataset stores its own crs_epsg; study areas declare their own.
ROADSCOPE_CANONICAL_EPSG=3857
# Demo study area seeded on first start (see GET /api/v1/study-areas). Ingestion is worldwide.
ROADSCOPE_DEFAULT_STUDY_AREA=tehran
ROADSCOPE_WEB_EPSG=4326
ROADSCOPE_DEFAULT_SEED=42

# Off by default. Enable ONLY in an isolated synthetic-only sandbox installation.
ROADSCOPE_DEMO_MODE=false

# JSON mapping of random bearer tokens to existing database usernames.
# Set out of band; never commit real tokens. Empty mapping allows read-only queries.
ROADSCOPE_API_TOKENS={}

# Local process override only; Compose mounts the persistent SQLite volume at /data/uai.sqlite.
# ROADSCOPE_SQLITE_PATH=data/uai.sqlite
