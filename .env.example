# SQLite is the only supported database. No PostGIS service is required.
UAI_API_PORT=8000
UAI_WEB_PORT=8080
# Off by default. Enable ONLY in an isolated synthetic-only installation.
ROADSCOPE_DEMO_MODE=false
# JSON mapping of random bearer tokens to existing database usernames.
# Set out of band; never commit real tokens. Blank mapping means read-only.
ROADSCOPE_API_TOKENS={}
# Set to the EXACT existing Docker volume name when upgrading; do not create an empty replacement.
ROADSCOPE_DATA_VOLUME=roadscope_uai_sqlite_data
# Local process only; Compose sets the path to /data/uai.sqlite.
# ROADSCOPE_SQLITE_PATH=data/uai.sqlite
# ROADSCOPE_* takes precedence over equivalent legacy UAI_* names.
UAI_CANONICAL_EPSG=25832
UAI_WEB_EPSG=4326
UAI_DEFAULT_SEED=42
