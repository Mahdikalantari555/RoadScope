# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection (contrib extensions cube + earthdistance are required; PostGIS is not).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC key for session tokens and privacy-preserving reporter hashes (>= 16 characters).
SESSION_SECRET=replace-with-a-long-random-string

# Bootstrap accounts created on first start (leave empty to skip).
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_USER_EMAIL=analyst@example.org
DEMO_USER_PASSWORD=replace-with-a-strong-password

# Synthetic demonstration workspace seed (fixed for reproducibility).
DEMO_SEED=20260101

# Attachment storage directory for citizen photographs.
UPLOAD_DIR=./data/uploads

# Maximum citizen reports per pseudonymous reporter per day.
DAILY_REPORT_LIMIT=25

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Set to true when served over HTTPS so session cookies carry the Secure flag.
COOKIE_SECURE=false
