.DS_Store

# Runtime SQLite databases. The default path is a local, regenerable synthetic demo database:
# the legacy Frankfurt (EPSG:25832) one is deliberately not shipped, so a first run seeds the
# configured demo study area (Tehran) instead of surprising an operator with another city.
data/*.sqlite
data/*.sqlite-*
data/backups/

# Runtime SQLite journals, backups, and reproducible frontend build artifacts
*.sqlite-*
*.sqlite.bak
*.sqlite.*.bak
**/backups/*.sqlite
frontend/static_bundle/
*.tsbuildinfo
