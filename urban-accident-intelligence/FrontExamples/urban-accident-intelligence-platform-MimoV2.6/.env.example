# Copy to `.env` and adjust. Never commit real secrets.

# --- PostgreSQL -----------------------------------------------------------
# Local development database. In Docker Compose the host is `db`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Spatial configuration ------------------------------------------------
# Analysis working CRS. This build uses a local equirectangular metric frame
# around the study centre; the PostGIS deployment should use a projected CRS
# appropriate to the study area (e.g. EPSG:25832 for central Europe).
ANALYSIS_CRS=EPSG:25832
SOURCE_CRS=EPSG:4326

# --- Synthetic data generation -------------------------------------------
# Fixed seed keeps the corpus reproducible across runs.
SYNTHETIC_SEED=20240917
SYNTHETIC_SCENARIO=mixed
SYNTHETIC_ACCIDENT_COUNT=1800

# --- Service configuration -----------------------------------------------
NEXT_PUBLIC_APP_NAME=Urban Accident Intelligence
NEXT_PUBLIC_STUDY_AREA=Meridian District
LOG_LEVEL=info

# --- Future integrations (not required for this build) --------------------
# POSTGIS_ENABLED=true
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
