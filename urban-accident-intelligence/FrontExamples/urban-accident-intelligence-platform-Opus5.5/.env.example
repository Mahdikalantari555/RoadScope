# PostgreSQL connection (PostGIS optional — see docs/postgis-migration.sql)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC secret for session cookies and contact hashing (>= 16 chars). REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" when served over HTTPS
COOKIE_SECURE=false

# Demo account passwords created on first boot (override in any shared deployment)
DEMO_ADMIN_PASSWORD=admin-demo
DEMO_CITIZEN_PASSWORD=citizen-demo
